```{=html}
<%
// Featured piece: the newest shelf item with `featured: true`.
for (const item of items) {
const path = item.path || '';
const dir = path.replace(/[^\/]*$/, '');
const words = String(item.title || '').trim().split(' ');
const last = words.pop();
const tags = item.categories || [];
%>
<section class="la-hero list">
<div class="la-hero-text">
<p class="la-tagline">Interactive notebooks from an economist who likes to show the working.</p>
<div class="la-kicker">
<span class="la-nb"><%= item.nb ? item.nb + ' · latest' : 'latest' %></span>
<span><%= item.date %></span><span>·</span><span><%= item.type || 'notebook' %></span>
</div>
<h1><%= words.join(' ') %> <span class="la-underline"><%= last %><svg viewBox="0 0 220 18" preserveAspectRatio="none" aria-hidden="true"><path class="la-draw" style="animation-delay:.5s" pathLength="1" d="M3 11 C 50 4, 110 15, 160 7 S 210 9, 217 6" fill="none" stroke="var(--la-gold)" stroke-width="5" stroke-linecap="round"/></svg></span></h1>
<% if (item.description) { %><p class="lede"><%= item.description %></p><% } %>
<% if (tags.length) { %><div class="la-tags-static"><% for (const t of tags) { %><span class="la-tag">#<%= t %></span> <% } %></div><% } %>
<div class="la-files">
<a class="la-btn" href="<%- path %>">Read the <%= item.type || 'notebook' %></a>
<% if (item.notebook) { %><a class="la-chip" href="<%- dir + item.notebook %>" download>.ipynb</a><% } %>
<% if (item.excel) { %><a class="la-chip" href="<%- dir + item.excel %>" download>.xlsx</a><% } %>
</div>
</div>
<% if (item['hero-data']) { %>
<figure class="la-hero-chart" data-hero-src="<%- dir + item['hero-data'] %>" data-xlabel="<%= item['hero-x'] || '' %>" data-ylabel="<%= item['hero-y'] || '' %>" data-format="<%= item['hero-format'] || '' %>">
<figcaption><%= item['hero-title'] || item.title %></figcaption>
<div class="la-hero-svg" role="img" aria-label="<%= item['hero-title'] || 'Chart' %>"></div>
<% if (item['hero-note']) { %><div class="note"><%= item['hero-note'] %></div><% } %>
</figure>
<% } else if (item.image) { %>
<figure class="la-hero-chart"><img src="<%- item.image %>" alt="<%= item['image-alt'] || '' %>" style="width:100%;border-radius:10px"></figure>
<% } %>
</section>
<% } %>
```
